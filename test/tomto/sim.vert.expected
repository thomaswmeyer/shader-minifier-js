#version 300 es
in vec2 iPos,iVel;in float iAng;in vec2 iHome;in float iSeed;in vec3 iAux;uniform float uT,uSeek,uAmp,uBrz,uAct,uJit,uDtn,uFleeR,uFleeF;uniform vec2 uPtr,uGust;out vec2 vPos,vVel;out float vAng;float u(float v){v=fract(v*.1031);v*=v+33.33;v*=v+v;return fract(v);}void main(){vec2 v=iPos,i=iVel;i+=(iHome-v)*mix(uSeek,.011,iAux.x)*(1.+iAux.z*13.)*uDtn;float f=(sin(v.x*.006+uT*.3)+cos(v.y*.006-uT*.24)+.5*sin((v.x+v.y)*.004+uT*.18))*3.1415927;vec2 x=vec2(cos(f),sin(f));i+=x*mix(uAmp*uBrz,.013*iAux.y*(44./84.),iAux.x)*uDtn;if(uAct>.5&&iAux.x<.5){vec2 f=v-uPtr;float x=dot(f,f);if(x<uFleeR*uFleeR&&x>.01){float v=sqrt(x),u=1.-v/uFleeR;u=u*u*uFleeF;vec2 g=f/v;i+=(g+vec2(-g.y,g))*u*uDtn;}}i=(i+(uGust+(vec2(u(iSeed*13.1),u(iSeed*7.7))*2.-1.)*uJit)*(1.-iAux.x))*pow(.9-iAux.z*.12,uDtn);v+=i*uDtn;f=length(i);vec2 s=f>1e-4?i/f:x;x=mix(x,s,clamp((f-.05)/.35,0.,1.));f=atan(x.y,x.x);vAng=iAng+atan(sin(f-iAng),cos(f-iAng))*min(.15*uDtn,1.);vPos=v;vVel=i;gl_Position=vec4(0);}
